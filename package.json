{
  "name": "ctct-cli",
  "version": "1.0.0",
  "description": "Command-line interface for the Constant Contact v3 API, built for humans and AI agents.",
  "keywords": [
    "constant-contact",
    "cli",
    "email-marketing",
    "contacts",
    "oauth",
    "agents"
  ],
  "license": "MIT",
  "author": "Matthew Maynes",
  "homepage": "https://github.com/mattmaynes/ctct-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattmaynes/ctct-cli.git"
  },
  "bugs": {
    "url": "https://github.com/mattmaynes/ctct-cli/issues"
  },
  "type": "commonjs",
  "bin": {
    "ctct": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist-test/test/*.test.js",
    "pretest": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.1.7",
    "commander": "^12.1.0",
    "ctct-api-client": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.63.0"
  }
}
